{
  "name": "BrassCount",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "cd android && gradlew assembleRelease",
    "android:bundle": "cd android && gradlew bundleRelease",
    "android:clean": "cd android && gradlew clean",
    "start": "react-native start",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:format": "npm run lint:fix && npm run format",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.5",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/native-stack": "^7.17.7",
    "react": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.4",
    "react-native-dotenv": "^4.1.1",
    "react-test-renderer": "19.2.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "resolutions": {
    "brace-expansion": "^5.0.7",
    "fast-xml-parser": "^4.5.8",
    "js-yaml": "^4.1.0",
    "@istanbuljs/load-nyc-config/js-yaml": "^4.1.0"
  }
}
